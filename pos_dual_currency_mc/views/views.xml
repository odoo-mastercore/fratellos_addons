	<record id="res_currency_alternative_tree" model="ir.ui.view">
		<field name="name">res_currency_alternative_tree</field>
		<field name="model">res.currency</field>
		<field name="inherit_id" ref="base.view_currency_tree"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='inverse_rate']" position="after">
				<field name="alternative_exchange_rate" digits="[12,6]"/>
			</xpath>
		</field>
	</record>

	<record id="res_currency_alternative_form" model="ir.ui.view">
		<field name="name">res_currency_alternative_form</field>
		<field name="model">res.currency</field>
		<field name="inherit_id" ref="base.view_currency_form"/>
