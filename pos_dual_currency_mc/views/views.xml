<?xml version="1.0" encoding="utf-8" ?>
<odoo>

	<record id="view_company_form_pcsmc" model="ir.ui.view">
        <field name="name">view_company_form_pcsmc</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="foreign_currency_id"/>
                <field name="include_order_details_in_pos_detail_report" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_view_form_multi_currency_pos" model="ir.ui.view">
        <field name="name">res_config_settings_view_form_multi_currency_pos </field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pos_iface_big_scrollbars']/.." position="after">
                <setting>
                    <field name="show_dual_currency"/>
                    <field name="show_currency" invisible="show_dual_currency == False"/>
                </setting>
                <setting>
                    <field name="opening_cash_mode"/>
                </setting>
                <setting>
                    <field name="enable_popup_references_payment"/>
                </setting>
                <setting>
                    <field name="forced_button_invoice"/>
                </setting>
                <setting>
                    <field name="disabled_print_invoice"/>
                </setting>
                <setting>
                    <field name="clear_search_adding_product"/>
                </setting>
                <!--<div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="hide_detail_kanban"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="hide_detail_kanban"/>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="disabled_pricelist_bottom"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="disabled_pricelist_bottom"/>
                    </div>
                </div>-->
                <setting>
                    <field name="hide_exchange_rate_pos"/>
                </setting>
                <setting>
                    <field name="enable_automatic_box_opening"/>
                </setting>
                <setting>
                    <field name="view_quantity_products"/>
                </setting>
                <!--<div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="hide_button_orders"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="hide_button_orders"/>
                    </div>
                </div>-->
            </xpath>
        </field>
    </record>

    <record id="pos_payment_method_view_form_inherit" model="ir.ui.view">
		<field name="name">pos.payment.method.form.inherit</field>
		<field name="model">pos.payment.method</field>
		<field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
		<field name="arch" type="xml">
            <field name="journal_id" position="before">
                <field name="enable_currencies" widget="boolean_toggle"/>
            </field>
			<field name="journal_id" position="after">
                <field name="show_currency_equivalence" widget="boolean_toggle" invisible="enable_currencies == True"/>
				<field name="currency_id" invisible="1"/>
			</field>
            <field name="outstanding_account_id" position="before">
                <field name="journal_type" invisible="True"/>
                <field name="company_id" invisible="True"/>
                <div colspan="2">
                    <group invisible="journal_type != 'cash'">
                        <field name="enable_amount_opening" widget="boolean_toggle"/>
                        <div colspan="2">
                            <group invisible="enable_amount_opening == False">
                                <field name="amount_opening"/>
                            </group>
                        </div>
                    </group>
                    <group invisible="journal_type != 'bank'">
                        <field name="enable_payment_lot" widget="boolean_toggle"/>
                        <field name="enable_payment_reference" widget="boolean_toggle"/>
                        <field name="enable_payment_terminal" widget="boolean_toggle"/>
                        <field name="enable_commission" widget="boolean_toggle"/>
                        <div colspan="2">
                            <group invisible="enable_commission == False">
                                <field name="default_account_commission_id"/>
                                <field name="rate_commission"/>
                            </group>
                        </div>
                        <field name="enable_islr" widget="boolean_toggle"/>
                        <div colspan="2">
                            <group invisible="enable_islr == False">
                                <field name="default_account_islr_id"/>
                                <field name="rate_islr"/>
                            </group>
                        </div>
                    </group>
                </div>
            </field>
		</field>
	</record>

    <record id="pos_view_pos_order_tree" model="ir.ui.view">
		<field name="name">pos_view_pos_order_tree</field>
		<field name="model">pos.order</field>
		<field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='amount_total']" position="after">
				<field name="company_foreign_currency_id" optional="hide"/>
                <field name="amount_total_foreign" widget="monetary" options="{'currency_field': 'company_foreign_currency_id'}"/>
                <field name="amount_paid" optional="show" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="amount_paid_foreign" optional="show" widget="monetary" options="{'currency_field': 'company_foreign_currency_id'}"/>
				<field name="pay_amount_cur" string="Pagos" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="pay_amount_foreign" string="Pagos en Divisas" widget="monetary" options="{'currency_field': 'company_foreign_currency_id'}"/>
			</xpath>
            <xpath expr="//field[@name='amount_total']" position="before">
                <field name="amount_tax" optional="show" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="amount_tax_foreign" optional="show" widget="monetary" options="{'currency_field': 'company_foreign_currency_id'}"/>
            </xpath>
		</field>
	</record>

    <record id="view_pos_order_filter_pdcmc" model="ir.ui.view">
        <field name="name">view_pos_order_filter_pdcmc</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//group//filter[@name='order_month']" position="after">
                <filter string="Tipo de pedido" name="order_credit" domain="[]" context="{'group_by': 'order_credit'}"/>
            </xpath>
        </field>
    </record>

    <record id="pos_order_view_inherit_form" model="ir.ui.view">
		<field name="name">pos.order.inherit.form.view</field>
		<field name="model">pos.order</field>
		<field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='payment_ids']/list/field[@name='amount']" position="after">
				<field name="pay_currency_id" optional="hide"/>
				<field name="amount_foreign" widget="monetary" options="{'currency_field': 'pay_currency_id'}"/>
			</xpath>
            <xpath expr="//field[@name='payment_ids']/list/field[@name='amount']" position="before">
                <field name="payment_lot" optional="show"/>
				<field name="payment_reference" optional="show"/>
				<field name="payment_terminal" optional="show"/>
			</xpath>
			<xpath expr="//field[@name='lines']/list/field[@name='price_unit']" position="after">
				<field name="price_unit_foreign" widget="monetary" optional="hide" options="{'currency_field': 'company_foreign_currency_id'}"/>
			</xpath>
			<xpath expr="//field[@name='lines']/list/field[@name='price_subtotal']" position="after">
				<field name="price_subtotal_foreign" widget="monetary" optional="hide" options="{'currency_field': 'company_foreign_currency_id'}"/>
			</xpath>
			<xpath expr="//field[@name='lines']/list/field[@name='price_subtotal_incl']" position="after">
				<field name="price_subtotal_incl_foreign" widget="monetary" optional="hide" options="{'currency_field': 'company_foreign_currency_id'}"/>
                <field name="company_foreign_currency_id" optional="hide" />
                
			</xpath>
            <xpath expr="//field[@name='amount_tax']" position="after">
                <field name="company_foreign_currency_id" invisible="True"/>
                
                <field name="amount_tax_foreign" widget="monetary" options="{'currency_field': 'company_foreign_currency_id'}"/>
            </xpath>
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="amount_total_foreign" widget="monetary" options="{'currency_field': 'company_foreign_currency_id'}"/>
            </xpath>
            <xpath expr="//field[@name='amount_paid']" position="after">
                <field name="amount_paid_foreign" widget="monetary" options="{'currency_field': 'company_foreign_currency_id'}"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="currency_rate_foreign"/>
            </xpath>
		</field>
	</record>

    <record id="view_pos_payment_form_dpc" model="ir.ui.view">
		<field name="name">view_pos_payment_form_dpc</field>
		<field name="model">pos.payment</field>
		<field name="inherit_id" ref="point_of_sale.view_pos_payment_form"/>
		<field name="arch" type="xml">
			<field name="amount" position="after">
				<field name="pay_currency_id" invisible="True"/>
				<field name="amount_foreign" widget="monetary" options="{'currency_field': 'pay_currency_id'}"/>
			</field>
		</field>
	</record>

    <record id="view_pos_payment_tree_dpc" model="ir.ui.view">
		<field name="name">view_pos_payment_tree_dpc</field>
		<field name="model">pos.payment</field>
		<field name="inherit_id" ref="point_of_sale.view_pos_payment_tree"/>
		<field name="arch" type="xml">
			<field name="amount" position="after">
				<field name="pay_currency_id" invisible="True"/>
				<field name="amount_foreign" widget="monetary" options="{'currency_field': 'pay_currency_id'}"/>
			</field>
		</field>
	</record>

    <record id="view_bank_statement_tree_pdcmc" model="ir.ui.view">
		<field name="name">view_bank_statement_tree_pdcmc</field>
		<field name="model">account.bank.statement</field>
		<field name="inherit_id" ref="account.view_bank_statement_tree"/>
		<field name="arch" type="xml">
			<field name="balance_start" position="before">
				<field name="currency_id" optional="hide"/>
				<field name="opening_balance" widget="monetary" options="{'currency_field': 'currency_id'}"/>
			</field>
            <field name="journal_id" position="before">
				<field name="payment_method_id" invisible="payment_method_id == False"/>
			</field>
            <field name="name" position="before">
				<field name="pos_session_id" invisible="pos_session_id == False"/>
			</field>
            <field name="balance_end_real" position="before">
				<field name="balance_end" invisible="balance_end == False"/>
			</field>
		</field>
	</record>
        
