<odoo>
    <!-- FORMATOS DE PAPEL -->
    <record id="paperformat_label_sheet_dymo_priceless" model="report.paperformat">
        <field name="name">Dymo Label Sheet Priceless</field>
        <field name="default" eval="True" />
        <field name="format">custom</field>
        <field name="page_height">57</field>
        <field name="page_width">32</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">0.0</field>
        <field name="margin_bottom">0.0</field>
        <field name="margin_left">0.0</field>
        <field name="margin_right">0.0</field>
        <field name="disable_shrinking" eval="True"/>
        <field name="dpi">96</field>
    </record>
</odoo>
