<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_form_view_lspt" model="ir.ui.view">
        <field name="name">product_template_form_view_plpt</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='taxes_div']" position="after">
                <field name="currency_id" invisible="True"/>
                <label for="list_secondary_price_total"/>
                <div name="list_price_uom_second">
                    <field name="list_secondary_price_total" widget="monetary"
                           options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="product_template_tree_view_lspt" model="ir.ui.view">
        <field name="name">product_template_tree_view_plpt</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="list_secondary_price_total" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}"/>
            </xpath>
        </field>
    </record>

    <record id="product_product_stock_tree_lspt" model="ir.ui.view">
        <field name="name">product_product_stock_tree_plpt</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.product_product_stock_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty_available']" position="before">
                <field name="currency_id" invisible="True"/>
                <field name="list_secondary_price_total" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}"/>
            </xpath>
        </field>
    </record>
</odoo>