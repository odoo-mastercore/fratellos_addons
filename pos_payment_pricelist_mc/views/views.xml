<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="product_pricelist_view_form_inherit" model="ir.ui.view">
        <field name="name">product_pricelist_view_form_inherit</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <field name="currency_id" position="after">
                <field name="enable_payment_exclusive_currency" widget="boolean_toggle"/>
            </field>
        </field>
    </record>

    <record id="pos_payment_method_view_form_inherit" model="ir.ui.view">
        <field name="name">pos_payment_method_view_form_inherit</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="disabled_exclusive_currency_in_pricelist" widget="boolean_toggle"/>
            </field>
        </field>
    </record>

</odoo>