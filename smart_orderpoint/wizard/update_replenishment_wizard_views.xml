<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_update_replenishment_wizard_form" model="ir.ui.view">
        <field name="name">update.replenishment.wizard.form</field>
        <field name="model">update.replenishment.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Replenishment Rules">
                <group>
                    <field name="company_ids" widget="many2many_tags"/>
                    <field name="file" filename="filename"/>
                </group>
                <footer>
                    <button string="Actualizar" type="object" name="action_update_replenishment" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <record id="action_update_replenishment_wizard" model="ir.actions.act_window">
        <field name="name">Actualizar reglas de reabastecimiento</field>
        <field name="res_model">update.replenishment.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_update_replenishment_wizard_form"/>
        <field name="target">new</field>
    </record>
    
    <menuitem name="Actualizar reglas de reabastecimiento"
        id="menu_update_replenishment_wizard"
        action="action_update_replenishment_wizard"
        parent="purchase.menu_purchase_products" 
        sequence="7"
    />
    
</odoo>

