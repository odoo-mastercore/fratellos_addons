<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="smart_order_point_purchase_order_tree" model="ir.ui.view">
        <field name="name">smart.orderpoint.purchase.order.tree</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                 <field name="company_inter" optional="show"/>
            </xpath>  
        </field>
    </record>

    <record id="smart_purchase_order_kpis_tree" model="ir.ui.view">
        <field name="name">smart.purchase.order.inherit.purchase.order.tree</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="company_inter" optional="show"/>
            </xpath>  
        </field>
    </record>

</odoo>
